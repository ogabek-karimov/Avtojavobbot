# Bu faylni .env nomiga ko'chiring va haqiqiy qiymatlarni kiriting.
# .env fayli hech qachon git'ga commit qilinmasin (.gitignore'da bor).

# @BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=

# https://console.anthropic.com dan olingan Claude API kaliti
ANTHROPIC_API_KEY=

# Boshlang'ich admin(lar) - vergul bilan ajratilgan Telegram ID(lar).
# Faqat adminlar sozlash buyruqlarini (/autoreply_on va h.k.) ishlata oladi,
# va /addadmin bilan boshqa adminlar qo'sha oladi. Botga /myid yozib, o'z ID
# raqamingizni bilib oling. Bu faqat birinchi marta ishga tushganda o'qiladi -
# keyinchalik admin ro'yxati data/settings.json faylida saqlanadi.
ADMIN_IDS=123456789

# Ixtiyoriy sozlamalar (standart qiymatlar bilan ishlaydi):
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_MAX_TOKENS=1024
# CLAUDE_EFFORT=low
# DEFAULT_SYSTEM_PROMPT=
# DATA_DIR=./data
# HISTORY_LIMIT=20
